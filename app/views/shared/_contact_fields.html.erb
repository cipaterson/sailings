<% hide_name_email = local_assigns.fetch(:hide_name_email, false) %>
<div class="contact-fields">
  <% unless hide_name_email %>
  <div class="contact-field-block">
    <%= f.label :full_name, "Full name" %>
    <%= f.text_field :full_name %>
  </div>
  <% end %>

  <div class="contact-field-block">
    <%= f.label :address1, "Address" %>
    <%= f.text_field :address1 %>
    <%= f.text_field :address2 %>
    <div class="contact-address-grid">
      <div>
        <%= f.label :city, "City/Suburb" %>
        <%= f.text_field :city %>
      </div>
      <div>
        <%= f.label :state, "State" %>
        <%= f.select :state, Sailing::AUSTRALIAN_STATES, { include_blank: "Select state" } %>
      </div>
      <div>
        <%= f.label :postcode, "Postcode" %>
        <%= f.text_field :postcode %>
      </div>
    </div>
  </div>

  <div class="contact-info-grid">
    <% unless hide_name_email %>
    <%= f.label :email_address, "Email" %>
    <%= f.email_field :email_address %>
    <% end %>

    <%= f.label :work_phone, "Work Phone" %>
    <%= f.telephone_field :work_phone %>

    <%= f.label :mobile, "Mobile" %>
    <%= f.telephone_field :mobile %>
  </div>
</div>
