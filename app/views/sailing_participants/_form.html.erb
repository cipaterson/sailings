<%= form_with model: form_args do |f| %>
  <%= hidden_field_tag :return_to, params[:return_to] %>
  <% if f.object.errors.any? %>
    <div>
      <% f.object.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <%= f.hidden_field :status %>

  <div>
    <%= f.label :climbing, "Are you able to climb on this voyage?" %>
    <%= f.select :climbing, [["Unspecified", 0], ["Yes", 1], ["No", 2]] %>
  </div>

  <div>
    <%= f.label :comment, "Comment (optional)" %>
    <%= f.text_area :comment, rows: 4 %>
  </div>

  <%= f.submit "Submit" %>
  <%= link_to "Cancel", sailings_path %>
<% end %>
