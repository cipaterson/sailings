<h1>Crew for <%= @sailing.purpose %></h1>

<%= link_to "Download Manifest (PDF)", manifest_sailing_path(@sailing), target: "_blank" %>

<%= form_with url: bulk_update_sailing_sailing_participants_path(@sailing), method: :patch do |f| %>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Mobile</th>
        <th>ESS</th>
        <th>Class</th>
        <th>MED</th>
        <th>WWVP Expires</th>
        <th>MSR</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      <% @sailing_participants.each do |participant| %>
        <tr>
          <td><%= participant.user.full_name %></td>
          <td><%= participant.user.mobile_phone %></td>
          <td><%= participant.user.ess_qualification %></td>
          <td><%= participant.user.sailing_class %></td>
          <td><%= participant.user.med_qualification %></td>
          <td><%= participant.user.wwvp_expires_on %></td>
          <td><%= participant.user.marine_safety_refresher_on %></td>
          <td>
            <%= select_tag "statuses[#{participant.id}]",
                options_for_select(SailingParticipant::STATUSES, participant.status) %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div>
    <%= f.submit "Save All" %>
    <%= link_to "Cancel", sailing_sailing_participants_path(@sailing) %>
  </div>
<% end %>

<h2>Add Crew</h2>

<% available_users = User.where.not(id: @sailing.sailing_participants.select(:user_id)) %>
<% if available_users.any? %>
  <%= form_with model: [@sailing, @sailing_participant] do |f| %>
    <% if @sailing_participant.errors.any? %>
      <ul>
        <% @sailing_participant.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    <% end %>

    <div>
      <%= f.label :user_id, "Member" %>
      <%= f.select :user_id, available_users.map { |u| [u.email_address, u.id] }, { include_blank: "Select crew member" } %>
    </div>

    <div>
      <%= f.label :status %>
      <%= f.select :status, SailingParticipant::STATUSES, { include_blank: "Select status" } %>
    </div>

    <div>
      <%= f.submit "Add Crew Member" %>
    </div>
  <% end %>
<% else %>
  <p>All users are already participating in this sailing.</p>
<% end %>

<%= link_to "Back to Voyages", sailings_path %>
