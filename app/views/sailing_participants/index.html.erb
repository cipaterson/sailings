<h1><%= @sailing.display_name %></h1>

<% accepted_emails = @sailing_participants.select { |sp| sp.status == "Accepted" }.map { |sp| sp.user.email_address } %>
<div style="display: flex; gap: 1rem; align-items: center; margin-bottom: 1rem;">
  <%= link_to "Download Sailing Plan (PDF)", manifest_sailing_path(@sailing), target: "_blank" %>
  <% if accepted_emails.any? %>
    <%= link_to "Email Accepted Crew",
          "mailto:?bcc=#{accepted_emails.join(',')}&subject=#{@sailing.display_name}",
          class: "button" %>
  <% else %>
    <button type="button" disabled>Email Accepted Crew</button>
  <% end %>
</div>

<%= form_with url: bulk_update_sailing_sailing_participants_path(@sailing), method: :patch,
      data: { controller: "unsaved-warning" } do |f| %>
  <table class="wide-table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Mobile</th>
        <th>ESS</th>
        <th>Class</th>
        <th>MED</th>
        <th>WWVP Expires</th>
        <th>MSR</th>
        <th>Climbing</th>
        <th>Attended</th>
        <th>Status</th>
        <th>Comment</th>
      </tr>
    </thead>
    <tbody>
      <% @sailing_participants.each do |participant| %>
        <tr>
          <td><%= participant.user.full_name %></td>
          <td><%= participant.user.contact&.mobile %></td>
          <td><%= participant.user.ess_qualification %></td>
          <td><%= participant.user.sailing_class %></td>
          <td><%= participant.user.med_qualification %></td>
          <td><%= participant.user.wwvp_expires_on %></td>
          <td><%= participant.user.marine_safety_refresher_on %></td>
          <td><%= { 1 => "Yes", 2 => "No" }[participant.climbing] %></td>
          <td>
            <%= check_box_tag "attended[#{participant.id}]", "1", participant.attended.to_i == 1 %>
          </td>
          <td>
            <%= select_tag "statuses[#{participant.id}]",
                options_for_select(SailingParticipant::STATUSES, participant.status) %>
          </td>
          <td><%= participant.comment %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div>
    <%= f.submit "Save All" %>
    <% if @sailing.status == "closed" %>
      <button type="submit" name="reopen_sailing" value="1">Reopen Registrations</button>
    <% else %>
      <button type="submit" name="close_sailing" value="1">Close to Registrations</button>
    <% end %>
    <%= link_to "Cancel", :back %>
  </div>
  <%= link_to "Export CSV", sailing_sailing_participants_path(@sailing, format: :csv) %>
<% end %>

<h2>Add Crew</h2>

<% available_users = User.where("roles_mask > 0").where.not(id: @sailing.sailing_participants.select(:user_id)) %>
<% if available_users.any? %>
  <%= form_with model: [@sailing, @sailing_participant] do |f| %>
    <% if @sailing_participant.errors.any? %>
      <ul>
        <% @sailing_participant.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    <% end %>

    <div>
      <%= f.label :user_id, "Member" %>
      <%= f.select :user_id, available_users.map { |u| [u.full_name, u.id] },
            { include_blank: "Select crew member" },
            { data: { controller: "searchable-select" } } %>
    </div>

    <%= f.hidden_field :status, value: "Accepted" %>

    <div>
      <%= f.submit "Add Crew Member", disabled: @sailing.status != "scheduled" %>
    </div>
  <% end %>
<% else %>
  <p>All users are already participating in this sailing.</p>
<% end %>

<h2>SMS Accepted Crew</h2>

<%= form_with url: sms_accepted_sailing_sailing_participants_path(@sailing), method: :post do %>
  <div>
    <%= label_tag :sms_message, "Message" %>
    <%= text_area_tag :sms_message, nil, rows: 4, placeholder: "Enter SMS message…", style: "width: 100%;" %>
  </div>
  <div style="margin-top: 0.5rem;">
    <%= submit_tag "Send SMS to Accepted Crew", disabled: accepted_emails.empty? %>
  </div>
<% end %>

<%= link_to "Back to Voyages", sailings_path %>
