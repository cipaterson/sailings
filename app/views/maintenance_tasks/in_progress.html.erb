<h1>In-Progress Maintenance Tasks</h1>

<p>
  <%= link_to "New Maintenance Task", new_maintenance_task_path, class: "button" %>
  <%= link_to "Fixed Tasks", maintenance_tasks_path, class: "button" %>
</p>

<table>
  <thead>
    <tr>
      <th>Problem</th>
      <th>State</th>
      <th>Priority</th>
      <th>Date Reported</th>
      <th>Reported By</th>
      <th>Date Fixed</th>
      <th>Fixed By</th>
    </tr>
  </thead>
  <tbody>
    <% @maintenance_tasks.each do |task| %>
      <tr>
        <td><%= link_to task.problem_description, task %></td>
        <td><%= task.state %></td>
        <td><%= task.priority %></td>
        <td><%= task.date_reported.strftime("%d %b %Y") if task.date_reported %></td>
        <td><%= task.who_reported_name %></td>
        <td><%= task.date_fixed.strftime("%d %b %Y") if task.date_fixed %></td>
        <td><%= task.who_fixed_name %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= render "application/pagination", current_page: @current_page, total_pages: @total_pages, from_date: nil, to_date: nil %>
