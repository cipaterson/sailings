<h1>Fixed Maintenance Tasks</h1>

<p>
  <%= link_to "New", new_maintenance_task_path, class: "button" %>
  <%= link_to "In-Progress Tasks", in_progress_maintenance_tasks_path, class: "button" %>
</p>

<%= form_with url: maintenance_tasks_path, method: :get, local: true do |f| %>
  <div style="display: flex; gap: 1rem; align-items: center; margin-bottom: 1rem;">
    <label>From: <%= date_field_tag :from_date, @from_date %></label>
    <label>To: <%= date_field_tag :to_date, @to_date %></label>
    <%= f.submit "Apply" %>
    <%= link_to "Reset", maintenance_tasks_path %>
  </div>
<% end %>

<table class="wide-table">
  <thead>
    <tr>
      <th>Problem</th>
      <th>State</th>
      <th>Priority</th>
      <th>Date Reported</th>
      <th>Reported By</th>
      <th>Date Fixed</th>
      <th>Fixed By</th>
      <th>Fixed Note</th>
    </tr>
  </thead>
  <tbody>
    <% @maintenance_tasks.each do |task| %>
      <tr>
        <td><%= link_to task.problem_description, edit_maintenance_task_path(task, return_to: request.fullpath) %></td>
        <td><%= task.state %></td>
        <td><%= task.priority %></td>
        <td><%= task.date_reported.strftime("%d %b %Y") if task.date_reported %></td>
        <td><%= task.who_reported_name %></td>
        <td><%= task.date_fixed.strftime("%d %b %Y") if task.date_fixed %></td>
        <td><%= task.who_fixed_name %></td>
        <td><%= task.fixed_note %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= render "application/pagination", current_page: @current_page, total_pages: @total_pages, from_date: @from_date, to_date: @to_date %>
