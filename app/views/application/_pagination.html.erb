<% if total_pages > 1 %>
  <% filter = { from_date: defined?(from_date) ? from_date : nil, to_date: defined?(to_date) ? to_date : nil }.compact %>
  <nav style="display: flex; gap: 0.4rem; align-items: center; margin-top: 1rem;">
    <%# Previous %>
    <% if current_page > 1 %>
      <%= link_to "← Previous", url_for(filter.merge(page: current_page - 1)) %>
    <% else %>
      <span style="color: #aaa;">← Previous</span>
    <% end %>

    <%# Page number window: ±2 around current, always show first and last %>
    <% window_start = [1, current_page - 2].max %>
    <% window_end   = [total_pages, current_page + 2].min %>

    <% if window_start > 1 %>
      <%= link_to "1", url_for(filter.merge(page: 1)) %>
      <% if window_start > 2 %><span>…</span><% end %>
    <% end %>

    <% (window_start..window_end).each do |p| %>
      <% if p == current_page %>
        <strong><%= p %></strong>
      <% else %>
        <%= link_to p, url_for(filter.merge(page: p)) %>
      <% end %>
    <% end %>

    <% if window_end < total_pages %>
      <% if window_end < total_pages - 1 %><span>…</span><% end %>
      <%= link_to total_pages, url_for(filter.merge(page: total_pages)) %>
    <% end %>

    <%# Next %>
    <% if current_page < total_pages %>
      <%= link_to "Next →", url_for(filter.merge(page: current_page + 1)) %>
    <% else %>
      <span style="color: #aaa;">Next →</span>
    <% end %>
  </nav>
<% end %>
