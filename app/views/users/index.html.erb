<h1>Members</h1>

<%= link_to "New Member", new_user_path, class: "button" if can?("office_staff") %>
<% if can?("office_staff") %>
  <% if @disabled_filter %>
    <%= link_to "All Members", users_path, class: "button" %>
  <% else %>
    <%= link_to "Disabled Members", users_path(disabled: 1), class: "button" %>
  <% end %>
<% end %>

<%= form_with url: users_path, method: :get do |f| %>
  <div style="display: flex; gap: 1rem; align-items: flex-start; flex-wrap: wrap; margin-bottom: 0.5rem;">
    <% unless @disabled_filter %>
    <div class="role-filter">
      <% User::ROLES.each do |role| %>
        <label>
          <%= check_box_tag "roles[]", role, @selected_roles.include?(role) %>
          <%= role.humanize %>
        </label>
      <% end %>
    </div>
    <% end %>
    <div style="display: flex; gap: 1rem; align-items: center;">
      <%= text_field_tag :search, @search, placeholder: "Name or email" %>
      <%= f.submit "Filter" %>
      <%= link_to "Reset", users_path %>
    </div>
  </div>
<% end %>

<table class="wide-table">
  <thead>
    <tr>
      <th>Name</th>
      <th>Email</th>
      <th>Mobile</th>
      <th>Membership Type</th>
      <th>Fees Paid</th>
      <th>Fees Due</th>
      <th>Roles</th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= link_to user.full_name, edit_user_path(user) %></td>
        <td><%= user.email_address %></td>
        <td><%= user.contact&.mobile %></td>
        <td><%= user.membership_type %></td>
        <td><%= user.fees_paid %></td>
        <td><%= user.fees_due %></td>
        <td><%= user.roles.join(", ") %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to "Export CSV", users_path(format: :csv, roles: @selected_roles, search: @search) %>
