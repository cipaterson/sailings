<h1>Members</h1>

<%= link_to "New Member", new_user_path, class: "button" if can?("office_staff") %>

<%= form_with url: users_path, method: :get do |f| %>
  <div style="display: flex; gap: 1rem; align-items: flex-start; flex-wrap: wrap; margin-bottom: 0.5rem;">
    <div class="role-filter">
      <% User::ROLES.each do |role| %>
        <label>
          <%= check_box_tag "roles[]", role, @selected_roles.include?(role) %>
          <%= role.humanize %>
        </label>
      <% end %>
    </div>
    <div style="display: flex; gap: 1rem; align-items: center;">
      <%= text_field_tag :search, @search, placeholder: "Name or email" %>
      <%= f.submit "Filter" %>
      <%= link_to "Reset", users_path %>
    </div>
  </div>
<% end %>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Email</th>
      <th>Mobile Phone</th>
      <th>Membership Type</th>
      <th>Roles</th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= link_to user.full_name, user %></td>
        <td><%= user.email_address %></td>
        <td><%= user.mobile_phone %></td>
        <td><%= user.membership_type %></td>
        <td><%= user.roles.join(", ") %></td>
      </tr>
    <% end %>
  </tbody>
</table>
