<h1>Users</h1>

<%= link_to "New User", new_user_path %>

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Email</th>
      <th>Membership Type</th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= link_to user.full_name, user %></td>
        <td><%= user.email_address %></td>
        <td><%= user.membership_type %></td>
      </tr>
    <% end %>
  </tbody>
</table>
