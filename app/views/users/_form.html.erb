<style>
  .tab-radio { display: none; }
  .tab-labels { display: flex; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 2px solid #ccc; }
  .tab-labels label { padding: 0.5rem 1rem; cursor: pointer; border: 1px solid transparent; border-bottom: none; margin-bottom: -2px; }
  .tab-panel { display: none; }

  #tab-personal:checked ~ .tab-labels label[for="tab-personal"],
  #tab-contact:checked ~ .tab-labels label[for="tab-contact"],
  #tab-membership:checked ~ .tab-labels label[for="tab-membership"],
  #tab-kin:checked ~ .tab-labels label[for="tab-kin"],
  #tab-training:checked ~ .tab-labels label[for="tab-training"],
  #tab-qualifications:checked ~ .tab-labels label[for="tab-qualifications"],
  #tab-roles:checked ~ .tab-labels label[for="tab-roles"] {
    border-color: #ccc; border-bottom-color: white; background: white; font-weight: bold;
  }

  #tab-personal:checked ~ .tab-panels #panel-personal,
  #tab-contact:checked ~ .tab-panels #panel-contact,
  #tab-membership:checked ~ .tab-panels #panel-membership,
  #tab-kin:checked ~ .tab-panels #panel-kin,
  #tab-training:checked ~ .tab-panels #panel-training,
  #tab-qualifications:checked ~ .tab-panels #panel-qualifications,
  #tab-roles:checked ~ .tab-panels #panel-roles {
    display: block;
  }
</style>

<%= form_with model: user, url: local_assigns[:url],
      data: (show_password ? { controller: "password-strength", "password-strength-optional-value": true } : {}) do |f| %>
  <%= hidden_field_tag :return_to, params[:return_to] %>
  <% if user.errors.any? %>
    <div>
      <ul>
        <% user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%
    available_tabs = %w[personal contact kin]
    available_tabs += %w[membership training qualifications roles] if can?("office_staff")
    active_tab = available_tabs.include?(local_assigns[:active_tab].to_s) ? local_assigns[:active_tab].to_s : "personal"
  %>
  <input type="radio" name="tab" id="tab-personal" class="tab-radio" <%= "checked" if active_tab == "personal" %>>
  <input type="radio" name="tab" id="tab-contact" class="tab-radio" <%= "checked" if active_tab == "contact" %>>
  <input type="radio" name="tab" id="tab-kin" class="tab-radio" <%= "checked" if active_tab == "kin" %>>
  <% if can?("office_staff") %>
    <input type="radio" name="tab" id="tab-membership" class="tab-radio" <%= "checked" if active_tab == "membership" %>>
    <input type="radio" name="tab" id="tab-training" class="tab-radio" <%= "checked" if active_tab == "training" %>>
    <input type="radio" name="tab" id="tab-qualifications" class="tab-radio" <%= "checked" if active_tab == "qualifications" %>>
    <input type="radio" name="tab" id="tab-roles" class="tab-radio" <%= "checked" if active_tab == "roles" %>>
  <% end %>

  <div class="tab-labels">
    <label for="tab-personal">Personal</label>
    <label for="tab-contact">Contact</label>
    <label for="tab-kin">Next of Kin</label>
    <% if can?("office_staff") %>
      <label for="tab-membership">Membership</label>
      <label for="tab-training">Training</label>
      <label for="tab-qualifications">Qualifications</label>
      <label for="tab-roles">Roles</label>
    <% end %>
  </div>

  <div class="tab-panels">
    <div id="panel-personal" class="tab-panel">
      <div>
        <%= f.label :email_address %>
        <%= f.email_field :email_address %>
      </div>
      <div>
        <%= f.label :first_name %>
        <%= f.text_field :first_name %>
      </div>
      <div>
        <%= f.label :last_name %>
        <%= f.text_field :last_name %>
      </div>
      <div>
        <%= f.label :birth_date %>
        <%= f.date_field :birth_date %>
      </div>
      <div>
        <%= f.label :occupation %>
        <%= f.text_field :occupation %>
      </div>
      <% if show_password %>
        <div>
          <%= f.label :password %>
          <%= f.password_field :password, autocomplete: "new-password", maxlength: 72,
                data: { password_strength_target: "password", action: "input->password-strength#check" } %>
          <ul class="password-checklist">
            <li data-rule="length"    data-password-strength-target="rule">✗ At least 6 characters</li>
            <li data-rule="uppercase" data-password-strength-target="rule">✗ At least one uppercase letter</li>
            <li data-rule="lowercase" data-password-strength-target="rule">✗ At least one lowercase letter</li>
            <li data-rule="digit"     data-password-strength-target="rule">✗ At least one number</li>
            <li data-rule="special"   data-password-strength-target="rule" data-optional="true">✗ At least one special character (optional)</li>
          </ul>
        </div>
        <div>
          <%= f.label :password_confirmation %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", maxlength: 72,
                data: { password_strength_target: "confirmation", action: "input->password-strength#check" } %>
          <span data-password-strength-target="matchMessage" class="password-match-message"></span>
        </div>
      <% end %>
    </div>

    <div id="panel-contact" class="tab-panel">
      <%= f.fields_for :contact do |cf| %>
        <%= render 'shared/contact_fields', f: cf, hide_name_email: true %>
      <% end %>
    </div>

    <div id="panel-kin" class="tab-panel">
      <%= f.fields_for :next_of_kin do |nf| %>
        <%= render 'shared/contact_fields', f: nf %>
      <% end %>
    </div>

    <% if can?("office_staff") %>
      <div id="panel-membership" class="tab-panel">
        <div>
          <%= f.label :membership_type %>
          <%= f.select :membership_type, User::MEMBERSHIP_TYPES, { include_blank: "Select type" } %>
        </div>
        <div>
          <%= f.label :sailing_class, "Class" %>
          <%= f.text_field :sailing_class %>
        </div>
        <div>
          <%= f.label :fees_due, "Fees Due" %>
          <%= f.number_field :fees_due, min: 2000, max: 2100 %>
        </div>
        <div>
          <%= f.label :days_sailed, "Days Sailed" %>
          <%= f.number_field :days_sailed %>
        </div>
        <div>
          <%= f.label :date_joined, "Date Joined" %>
          <%= f.date_field :date_joined %>
        </div>
        <div>
          <%= f.label :last_sailed, "Last Sailed" %>
          <%= f.date_field :last_sailed %>
        </div>
        <div>
          <%= f.label :fees_paid, "Fees Paid" %>
          <%= f.date_field :fees_paid %>
        </div>
        <div>
          <%= f.label :rcpt_number, "Rcpt Number" %>
          <%= f.text_field :rcpt_number %>
        </div>
        <div>
          <%= f.label :sit2_date, "SIT2 Date" %>
          <%= f.date_field :sit2_date %>
        </div>
        <div>
          <%= f.label :sit_date, "SIT1 Date" %>
          <%= f.date_field :sit_date %>
        </div>
      </div>

      <div id="panel-training" class="tab-panel">
        <div>
          <%= f.label :knots_on, "Knots" %>
          <%= f.date_field :knots_on %>
        </div>
        <div>
          <%= f.label :marine_safety_refresher_on, "Marine Safety Refresher" %>
          <%= f.date_field :marine_safety_refresher_on %>
        </div>
      </div>

      <div id="panel-qualifications" class="tab-panel">
        <table>
          <thead>
            <tr>
              <th></th>
              <th>Qualification</th>
              <th>Date Issued</th>
              <th>Date Expired</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>ESS</td>
              <td><%= f.text_field :ess_qualification %></td>
              <td><%= f.date_field :ess_issued_on %></td>
              <td><%= f.date_field :ess_expires_on %></td>
            </tr>
            <tr>
              <td>MED</td>
              <td><%= f.text_field :med_qualification %></td>
              <td><%= f.date_field :med_issued_on %></td>
              <td><%= f.date_field :med_expires_on %></td>
            </tr>
            <tr>
              <td>WWVP</td>
              <td><%= f.text_field :wwvp_qualification %></td>
              <td><%= f.date_field :wwvp_issued_on %></td>
              <td><%= f.date_field :wwvp_expires_on %></td>
            </tr>
            <tr>
              <td>First Aid</td>
              <td><%= f.text_field :first_aid_qualification %></td>
              <td><%= f.date_field :first_aid_issued_on %></td>
              <td><%= f.date_field :first_aid_expires_on %></td>
            </tr>
            <tr>
              <td>Coxswain Cert.</td>
              <td><%= f.text_field :coxswain_qualification %></td>
              <td><%= f.date_field :coxswain_issued_on %></td>
              <td><%= f.date_field :coxswain_expires_on %></td>
            </tr>
            <tr>
              <td>Food Handling</td>
              <td><%= f.text_field :food_handling_qualification %></td>
              <td><%= f.date_field :food_handling_issued_on %></td>
              <td><%= f.date_field :food_handling_expires_on %></td>
            </tr>
          </tbody>
        </table>
      </div>

      <div id="panel-roles" class="tab-panel">
        <fieldset>
          <legend>Roles</legend>
          <% User::ROLES.each do |role| %>
            <div>
              <label>
                <%= check_box_tag "user[roles][]", role, user.has_role?(role), id: "user_roles_#{role}" %>
                <%= role.humanize %>
              </label>
            </div>
          <% end %>
          <%# Hidden field ensures an empty array is submitted when no roles are checked %>
          <%= hidden_field_tag "user[roles][]", "" %>
        </fieldset>
      </div>
    <% end %>
  </div>

  <div>
    <%= f.submit local_assigns[:submit_label], data: (show_password ? { password_strength_target: "submit" } : {}) %>
  </div>
<% end %>
