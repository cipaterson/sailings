<h1><%= @user.full_name %></h1>

<table>
  <tbody>
    <tr><th>Email</th><td><%= @user.email_address %></td></tr>
    <tr><th>First Name</th><td><%= @user.first_name %></td></tr>
    <tr><th>Last Name</th><td><%= @user.last_name %></td></tr>
    <tr><th>Mobile</th><td><%= @user.contact&.mobile %></td></tr>
    <tr><th>Work Phone</th><td><%= @user.contact&.work_phone %></td></tr>
    <tr><th>Address</th><td><%= @user.contact&.address1 %></td></tr>
    <tr><th>Birth Date</th><td><%= @user.birth_date %></td></tr>
    <tr><th>Occupation</th><td><%= @user.occupation %></td></tr>
    <tr><th>Membership Type</th><td><%= @user.membership_type %></td></tr>
    <tr><th>Class</th><td><%= @user.sailing_class %></td></tr>
    <tr><th>SIT Date</th><td><%= @user.sit_date %></td></tr>
    <tr><th>Roles</th><td><%= @user.roles.map(&:humanize).join(", ") %></td></tr>
    <tr><th>Knots</th><td><%= @user.knots_on %></td></tr>
    <tr><th>Marine Safety Refresher</th><td><%= @user.marine_safety_refresher_on %></td></tr>
    <tr><th>ESS</th><td><%= @user.ess_qualification %></td></tr>
    <tr><th>ESS Issued</th><td><%= @user.ess_issued_on %></td></tr>
    <tr><th>ESS Expires</th><td><%= @user.ess_expires_on %></td></tr>
    <tr><th>MED</th><td><%= @user.med_qualification %></td></tr>
    <tr><th>MED Issued</th><td><%= @user.med_issued_on %></td></tr>
    <tr><th>MED Expires</th><td><%= @user.med_expires_on %></td></tr>
    <tr><th>WWVP</th><td><%= @user.wwvp_qualification %></td></tr>
    <tr><th>WWVP Issued</th><td><%= @user.wwvp_issued_on %></td></tr>
    <tr><th>WWVP Expires</th><td><%= @user.wwvp_expires_on %></td></tr>
  </tbody>
</table>

<%= link_to "Edit", edit_user_path(@user), class: "button" %>
<%= link_to "Back", users_path %>
