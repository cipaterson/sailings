<h1>My Registrations</h1>

<% if @sailing_participants.any? %>
  <div class="wide-table">
  <table>
    <thead>
      <tr>
        <th>Voyage</th>
        <th>Voyage Dates</th>
        <th>Created</th>
        <th>Registration</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @sailing_participants.each do |participant| %>
        <tr>
          <td><%= participant.sailing.charterer %></td>
          <td><%= participant.sailing.voyage_dates %></td>
          <td><%= participant.created_at.in_time_zone.strftime("%d %b %Y - %H:%M") %></td>
          <td><%= participant.status %></td>
          <td><%= link_to "Edit", edit_sailing_participant_path(participant), class: "button" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  </div>
<% else %>
  <p>You have no registrations.</p>
<% end %>
