<h1>Apply for membership</h1>

<p>Create your account below. Once you've applied, the club office will confirm your
payment and approve your membership — you'll be able to sign in after that.</p>

<%= form_with model: @user, url: registration_path,
      data: { controller: "password-strength", "password-strength-optional-value": true } do |f| %>
  <% if @user.errors.any? %>
    <div>
      <ul>
        <% @user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <h2>Personal</h2>
  <div class="form-row">
    <div>
      <%= f.label :first_name %>
      <%= f.text_field :first_name %>
    </div>
    <div>
      <%= f.label :last_name %>
      <%= f.text_field :last_name %>
    </div>
  </div>
  <div class="form-row">
    <div>
      <%= f.label :birth_date %>
      <%= f.date_field :birth_date %>
    </div>
    <div>
      <%= f.label :email_address %>
      <%= f.email_field :email_address %>
    </div>
    <div>
      <%= f.label :occupation %>
      <%= f.text_field :occupation %>
    </div>
  </div>
  <div class="form-row">
    <div>
      <%= f.label :password %>
      <%= f.password_field :password, autocomplete: "new-password", maxlength: 72,
            data: { password_strength_target: "password", action: "input->password-strength#check" } %>
      <ul class="password-checklist">
        <li data-rule="length"    data-password-strength-target="rule">✗ At least 6 characters</li>
        <li data-rule="uppercase" data-password-strength-target="rule">✗ At least one uppercase letter</li>
        <li data-rule="lowercase" data-password-strength-target="rule">✗ At least one lowercase letter</li>
        <li data-rule="digit"     data-password-strength-target="rule">✗ At least one number</li>
        <li data-rule="special"   data-password-strength-target="rule" data-optional="true">✗ At least one special character (optional)</li>
      </ul>
    </div>
    <div>
      <%= f.label :password_confirmation %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", maxlength: 72,
            data: { password_strength_target: "confirmation", action: "input->password-strength#check" } %>
      <span data-password-strength-target="matchMessage" class="password-match-message"></span>
    </div>
  </div>

  <h2>Contact</h2>
  <%= f.fields_for :contact do |cf| %>
    <%= render "shared/contact_fields", f: cf, hide_name_email: true %>
  <% end %>

  <h2>Next of Kin</h2>
  <%= f.fields_for :next_of_kin do |nf| %>
    <%= render "shared/contact_fields", f: nf %>
  <% end %>
  <div class="contact-info-grid">
    <%= f.label :next_of_kin_relationship, "Relationship" %>
    <%= f.text_field :next_of_kin_relationship %>
  </div>

  <h2>Membership Fees and Rates</h2>
  <p>(membership valid 1st July to 30th June)</p>
  <table>
    <tbody>
      <tr><td>Junior</td><td>Members less than 18 years of age.</td><td>$20</td></tr>
      <tr><td></td><td colspan="2"><em>(Juniors are not eligible to vote)</em></td></tr>
      <tr><td>Student</td><td>Full Time</td><td>$35</td></tr>
      <tr><td>Individual</td><td>Adult 18 years of age and over</td><td>$60</td></tr>
      <tr><td>Family</td><td>Parents and children up to 17 years of age</td><td>$80</td></tr>
      <tr><td></td><td colspan="2"><em>(Family members' names – see next page)</em></td></tr>
    </tbody>
  </table>

  <p>
    <strong>Direct deposit:</strong><br>
    Account name: Tasmanian Sail Training Association<br>
    BSB: 067-100 &nbsp; Account Number: 1030 2295
  </p>

  <h2>Skills</h2>
  <% User::SKILL_GROUPS.each do |group, skills| %>
    <fieldset class="skills-group">
      <legend><%= group %></legend>
      <div class="skills-options">
        <% skills.each do |skill| %>
          <label>
            <%= check_box_tag "user[skills][]", skill, @user.has_skill?(skill), id: "user_skills_#{skill}" %>
            <%= skill.titleize %>
          </label>
        <% end %>
      </div>
    </fieldset>
  <% end %>
  <%# Hidden field ensures an empty array is submitted when nothing is checked %>
  <%= hidden_field_tag "user[skills][]", "" %>
  <div>
    <%= f.label :special_skills, "Special Skills or Knowledge" %>
    <%= f.text_area :special_skills %>
  </div>

  <div>
    <%= f.submit "Apply", data: { password_strength_target: "submit" } %>
  </div>
<% end %>

<div style="margin-top: 1rem;">
  <%= link_to "Back to sign in", new_session_path %>
</div>
