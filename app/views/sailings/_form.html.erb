<style>
  .tab-radio { display: none; }
  .tab-labels { display: flex; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 2px solid #ccc; }
  .tab-labels label { padding: 0.5rem 1rem; cursor: pointer; border: 1px solid transparent; border-bottom: none; margin-bottom: -2px; }
  .tab-panel { display: none; }

  #sailing-tab-info:checked ~ .tab-labels label[for="sailing-tab-info"],
  #sailing-tab-charter:checked ~ .tab-labels label[for="sailing-tab-charter"],
  #sailing-tab-costs:checked ~ .tab-labels label[for="sailing-tab-costs"] {
    border-color: #ccc; border-bottom-color: white; background: white; font-weight: bold;
  }

  #sailing-tab-info:checked ~ .tab-panels #panel-info,
  #sailing-tab-charter:checked ~ .tab-panels #panel-charter,
  #sailing-tab-costs:checked ~ .tab-panels #panel-costs {
    display: block;
  }
</style>

<%= form_with model: sailing do |f| %>
  <% if sailing.errors.any? %>
    <div>
      <ul>
        <% sailing.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <input type="radio" name="sailing_tab" id="sailing-tab-info" class="tab-radio"
         <%= "checked" if params[:tab].blank? || params[:tab] == "info" %>>
  <% if sailing.charterer.present? %>
    <input type="radio" name="sailing_tab" id="sailing-tab-charter" class="tab-radio"
           <%= "checked" if params[:tab] == "charter" %>>
    <input type="radio" name="sailing_tab" id="sailing-tab-costs" class="tab-radio"
           <%= "checked" if params[:tab] == "costs" %>>
  <% end %>

  <div class="tab-labels">
    <label for="sailing-tab-info">Voyage Information</label>
    <% if sailing.charterer.present? %>
      <label for="sailing-tab-charter">Charter Contact</label>
      <label for="sailing-tab-costs">Charter Costs</label>
    <% end %>
  </div>

  <div class="tab-panels">
    <div id="panel-info" class="tab-panel">
      <%= render 'voyage_dates', f: f %>

      <div style="display: flex; gap: 1.5rem; flex-wrap: wrap;">
        <div>
          <%= f.label :sailing_type, "Sailing Type" %>
          <%= f.select :sailing_type, Sailing::SAILING_TYPES, { include_blank: "Select type" } %>
        </div>
        <div>
          <%= f.label :status, "Status" %>
          <%= f.select :status, Sailing::SAILING_STATUSES %>
        </div>
        <div>
          <%= f.label :training, "Training" %>
          <%= f.select :training, Sailing::TRAINING_TYPES, { include_blank: "None" } %>
        </div>
      </div>

      <div>
        <%= f.label :purpose, "Voyage Purpose" %>
        <%= f.text_field :purpose %>
      </div>

      <div>
        <%= f.label :passenger_count, "No. of Passengers" %>
        <%= f.number_field :passenger_count %>
      </div>

      <div>
        <%= f.label :ln_contact %>
        <%= f.text_field :ln_contact %>
      </div>

      <div>
        <%= f.label :charterer %>
        <%= f.text_field :charterer %>
      </div>

      <div>
        <%= f.label :additional_details %>
        <%= f.text_area :additional_details %>
      </div>

      <div>
        <%= f.label :comments %>
        <%= f.text_area :comments %>
      </div>

      <div>
        <%= f.label :master %>
        <%= f.text_field :master %>
      </div>

      <div>
        <%= f.label :engineer %>
        <%= f.text_field :engineer %>
      </div>
    </div>

    <div id="panel-charter" class="tab-panel">
      <%= f.fields_for :charter_contact do |cf| %>
        <%= render 'shared/contact_fields', f: cf %>
      <% end %>
    </div>

    <div id="panel-costs" class="tab-panel">
      <fieldset style="border: 1px solid #ccc; border-radius: 4px; padding: 1rem; margin-bottom: 1rem;">
        <legend><strong>Quote</strong></legend>
        <div style="display: flex; gap: 1.5rem; flex-wrap: wrap;">
          <div>
            <%= f.label :charter_state, "Charter State" %>
            <%= f.select :charter_state, Sailing::CHARTER_STATES %>
          </div>
          <div>
            <%= f.label :quoted_cost, "Quoted Cost" %>
            <%= f.text_field :quoted_cost %>
          </div>
        </div>
      </fieldset>

      <fieldset style="border: 1px solid #ccc; border-radius: 4px; padding: 1rem; margin-bottom: 1rem;">
        <legend><strong>Deposit</strong></legend>
        <div style="display: flex; gap: 1.5rem; flex-wrap: wrap;">
          <div>
            <%= f.label :deposit_invoice, "Invoice No." %>
            <%= f.text_field :deposit_invoice %>
          </div>
          <div>
            <%= f.label :deposit_invoice_date, "Invoice Date" %>
            <%= f.date_field :deposit_invoice_date %>
          </div>
          <div>
            <%= f.label :deposit, "Deposit Amount" %>
            <%= f.text_field :deposit %>
          </div>
          <div>
            <%= f.label :deposit_receipt_no, "Receipt No." %>
            <%= f.text_field :deposit_receipt_no %>
          </div>
        </div>
      </fieldset>

      <fieldset style="border: 1px solid #ccc; border-radius: 4px; padding: 1rem; margin-bottom: 1rem;">
        <legend><strong>Final Payment</strong></legend>
        <div style="display: flex; gap: 1.5rem; flex-wrap: wrap;">
          <div>
            <%= f.label :final_invoice, "Invoice No." %>
            <%= f.text_field :final_invoice %>
          </div>
          <div>
            <%= f.label :invoice_date, "Invoice Date" %>
            <%= f.date_field :invoice_date %>
          </div>
          <div>
            <%= f.label :final_amount, "Final Amount" %>
            <%= f.text_field :final_amount %>
          </div>
          <div>
            <%= f.label :date_paid, "Date Paid" %>
            <%= f.date_field :date_paid %>
          </div>
          <div>
            <%= f.label :receipt_no, "Receipt No." %>
            <%= f.text_field :receipt_no %>
          </div>
        </div>
      </fieldset>
    </div>
  </div>

  <div>
    <%= f.submit %>
  </div>
<% end %>
