<%
  day_start = @date.beginning_of_day
  day_end   = @date.end_of_day
  day_sailings = sailings.select { |s|
    depart_day = s.departs_at.to_date
    return_day = s.returns_at&.to_date || depart_day
    depart_day <= @date && return_day >= @date
  }
  multi_day = day_sailings.select { |s| s.returns_at && s.returns_at.to_date > s.departs_at.to_date }
  timed     = day_sailings - multi_day
%>

<% if multi_day.any? %>
  <div class="cal-allday-day">
    <% multi_day.each do |sailing| %>
      <%
        bar_classes = ["cal-allday-bar"]
        bar_classes << "registered" if my_participants[sailing.id]
      %>
      <%= link_to sailing_path(sailing), class: bar_classes.join(" ") do %>
        <strong><%= sailing.purpose.presence || sailing.charterer %></strong>
        <span class="cal-sailing-time">
          <%= sailing.departs_at.strftime("%-d %b %H:%M") %> – <%= sailing.returns_at.strftime("%-d %b %H:%M") %>
        </span>
      <% end %>
    <% end %>
  </div>
<% end %>

<% if day_sailings.empty? %>
  <p class="cal-no-events">There are no events</p>
<% else %>
  <div class="cal-scroll-container" data-controller="time-grid">
    <div class="cal-time-wrapper">
      <div class="cal-time-gutter">
        <% 0.upto(23) do |hour| %>
          <div class="cal-time-label" style="top: <%= hour * 60 %>px;"><%= sprintf("%02d:00", hour) %></div>
        <% end %>
      </div>

      <div class="cal-day-col">
        <% timed.each do |sailing| %>
          <%
            start_t   = [sailing.departs_at, day_start].max
            end_t     = sailing.returns_at ? [sailing.returns_at, day_end].min : sailing.departs_at + 1.hour
            top_px    = ((start_t - day_start) / 60).round
            height_px = [((end_t - start_t) / 60).round, 24].max
            block_classes = ["cal-sailing-block"]
            block_classes << "registered" if my_participants[sailing.id]
          %>
          <%= link_to sailing_path(sailing),
                      class: block_classes.join(" "),
                      style: "top: #{top_px}px; height: #{height_px}px;" do %>
            <strong><%= sailing.purpose.presence || sailing.charterer %></strong>
            <span class="cal-sailing-time">
              <%= sailing.departs_at.strftime("%H:%M") %><% if sailing.returns_at %> – <%= sailing.returns_at.strftime("%-d %b %H:%M") %><% end %>
            </span>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
