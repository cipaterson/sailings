<%
  title = case @view
  when "week"
    week_start = @date.beginning_of_week(:monday)
    "Voyages — Week of #{week_start.strftime("%-d %B %Y")}"
  when "day"
    "Voyages — #{@date.strftime("%A, %-d %B %Y")}"
  else
    "Voyages — #{Date::MONTHNAMES[@month]} #{@year}"
  end
%>
<h1><%= title %></h1>

<%
  prev_params = { view: @view }
  next_params = { view: @view }
  prev_label  = ""
  next_label  = ""

  case @view
  when "week"
    ws        = @date.beginning_of_week(:monday)
    prev_date = ws - 1.week
    next_date = ws + 1.week
    prev_params.merge!(year: prev_date.year, month: prev_date.month, day: prev_date.day)
    next_params.merge!(year: next_date.year, month: next_date.month, day: next_date.day)
    prev_label = "‹ Week of #{prev_date.strftime("%-d %b")}"
    next_label = "Week of #{next_date.strftime("%-d %b")} ›"
  when "day"
    prev_date = @date - 1.day
    next_date = @date + 1.day
    prev_params.merge!(year: prev_date.year, month: prev_date.month, day: prev_date.day)
    next_params.merge!(year: next_date.year, month: next_date.month, day: next_date.day)
    prev_label = "‹ #{prev_date.strftime("%-d %b")}"
    next_label = "#{next_date.strftime("%-d %b")} ›"
  else
    prev_month = Date.new(@year, @month, 1).prev_month
    next_month = Date.new(@year, @month, 1).next_month
    prev_params.merge!(year: prev_month.year, month: prev_month.month)
    next_params.merge!(year: next_month.year, month: next_month.month)
    prev_label = "‹ #{Date::MONTHNAMES[prev_month.month]} #{prev_month.year}"
    next_label = "#{Date::MONTHNAMES[next_month.month]} #{next_month.year} ›"
  end
%>

<div style="display: flex; gap: 1rem; align-items: center; margin-bottom: 1rem; flex-wrap: wrap;">
  <span style="display: flex; gap: 0.25rem;">
    <%= link_to "Month", calendar_sailings_path(view: "month", year: @year, month: @month),
          style: @view == "month" ? "font-weight: bold; text-decoration: underline;" : "" %>
    <%= link_to "Week", calendar_sailings_path(view: "week", year: @date.year, month: @date.month, day: @date.day),
          style: @view == "week" ? "font-weight: bold; text-decoration: underline;" : "" %>
    <%= link_to "Day", calendar_sailings_path(view: "day", year: @date.year, month: @date.month, day: @date.day),
          style: @view == "day" ? "font-weight: bold; text-decoration: underline;" : "" %>
  </span>

  <%= link_to prev_label, calendar_sailings_path(prev_params) %>
  <%= link_to next_label, calendar_sailings_path(next_params) %>
</div>

<%= render "sailings/#{@view}", sailings: @sailings, my_participants: @my_participants %>
