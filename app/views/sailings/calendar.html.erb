<%
  title = case @view
  when "week"
    week_start = @date.beginning_of_week(:monday)
    "Voyages — Week of #{week_start.strftime("%-d %B %Y")}"
  when "day"
    "Voyages — #{@date.strftime("%A, %-d %B %Y")}"
  else
    "Voyages — #{Date::MONTHNAMES[@month]} #{@year}"
  end
%>
<h1><%= title %></h1>

<%= link_to "New Voyage", new_sailing_path, class: "button" if can?("office_staff") %>

<%
  case @view
  when "week"
    ws        = @date.beginning_of_week(:monday)
    prev_date = ws - 1.week
    next_date = ws + 1.week
    prev_params = { view: @view, year: prev_date.year, month: prev_date.month, day: prev_date.day }
    next_params = { view: @view, year: next_date.year, month: next_date.month, day: next_date.day }
  when "day"
    prev_date = @date - 1.day
    next_date = @date + 1.day
    prev_params = { view: @view, year: prev_date.year, month: prev_date.month, day: prev_date.day }
    next_params = { view: @view, year: next_date.year, month: next_date.month, day: next_date.day }
  else
    prev_month = Date.new(@year, @month, 1).prev_month
    next_month = Date.new(@year, @month, 1).next_month
    prev_params = { view: @view, year: prev_month.year, month: prev_month.month }
    next_params = { view: @view, year: next_month.year, month: next_month.month }
  end
%>

<div style="display: flex; gap: 1rem; align-items: center; margin-bottom: 1rem; flex-wrap: wrap;">
  <div class="cal-tabs">
    <%= link_to "Month", calendar_sailings_path(view: "month", year: @year, month: @month),
          class: "cal-tab #{"cal-tab--active" if @view == "month"}" %>
    <%= link_to "Week", calendar_sailings_path(view: "week", year: @date.year, month: @date.month, day: @date.day),
          class: "cal-tab #{"cal-tab--active" if @view == "week"}" %>
    <%= link_to "Day", calendar_sailings_path(view: "day", year: @date.year, month: @date.month, day: @date.day),
          class: "cal-tab #{"cal-tab--active" if @view == "day"}" %>
  </div>

  <%= link_to "‹ Prev", calendar_sailings_path(prev_params), class: "button" %>
  <%= link_to "Next ›", calendar_sailings_path(next_params), class: "button" %>
</div>

<%= render "sailings/#{@view}", sailings: @sailings, my_participants: @my_participants %>
