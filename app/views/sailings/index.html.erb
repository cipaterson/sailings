<h1>Voyages</h1>

<%= link_to "New Voyage", new_sailing_path, class: "button" if can?("office_staff") %>

<%= form_with url: sailings_path, method: :get, local: true do |f| %>
  <div style="display: flex; gap: 1rem; align-items: center; margin-bottom: 1rem;">
    <label>From: <%= date_field_tag :from_date, @from_date %></label>
    <label>To: <%= date_field_tag :to_date, @to_date %></label>
    <%= f.submit "Apply" %>
    <%= link_to "Reset", sailings_path %>
  </div>
<% end %>

<div class="wide-table">
<table>
  <thead>
    <tr>
      <th>Day</th>
      <th>Date</th>
      <th>Purpose</th>
      <th>Charterer</th>
      <th>Time</th>
      <th>Date Return</th>
      <th>Time Return</th>
      <th>LN Contact</th>
      <th>Master</th>
      <th>Crew</th>
      <th>Comments</th>
      <% if can?("crewing_operator") %>
        <th></th>
      <% end %>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @sailings.each do |sailing| %>
      <tr>
        <td><%= sailing.departs_at&.strftime("%a") %></td>
        <td><%= sailing.departs_at&.to_date %></td>
        <td>
          <% if can?("office_staff") %>
            <%= link_to sailing.purpose, edit_sailing_path(sailing) %>
          <% else %>
            <%= sailing.purpose %>
          <% end %>
        </td>
        <td><%= sailing.charterer %></td>
        <td><%= sailing.departs_at&.strftime("%H:%M") %></td>
        <td><%= sailing.returns_at&.to_date unless sailing.returns_at&.to_date == sailing.departs_at&.to_date %></td>
        <td><%= sailing.returns_at&.strftime("%H:%M") %></td>
        <td><%= sailing.ln_contact %></td>
        <td><%= sailing.master %></td>
        <td><%= sailing.participants_count %></td>
        <td><%= sailing.comments %></td>
        <% if can?("crewing_operator") %>
          <td><%= link_to "Manage Crew", sailing_sailing_participants_path(sailing), class: "button" %></td>
        <% end %>
        <td>
          <% my_participant = @my_participants[sailing.id] %>
          <% if my_participant %>
            <%= link_to "Registered", edit_sailing_participant_path(my_participant) %>
          <% else %>
            <%= link_to "Register", new_sailing_sailing_participant_path(sailing), class: "button" %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
</div>

<%= link_to "Export CSV", sailings_path(format: :csv, from_date: @from_date, to_date: @to_date) %>

<%= render "application/pagination", current_page: @current_page, total_pages: @total_pages, from_date: @from_date, to_date: @to_date %>
