<h1>Sailings</h1>

<%= link_to "New Sailing", new_sailing_path %>

<table>
  <thead>
    <tr>
      <th>Purpose</th>
      <th>Status</th>
      <th>Departs Date</th>
      <th>Departs Time</th>
      <th>Returns Date</th>
      <th>Returns Time</th>
      <th>LN Contact</th>
      <th>Master</th>
      <th>Participants</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @sailings.each do |sailing| %>
      <tr>
        <td><%= link_to sailing.purpose, sailing %></td>
        <td><%= sailing.status %></td>
        <td><%= sailing.departs_at&.to_date %></td>
        <td><%= sailing.departs_at&.strftime("%H:%M") %></td>
        <td><%= sailing.returns_at&.to_date unless sailing.returns_at&.to_date == sailing.departs_at&.to_date %></td>
        <td><%= sailing.returns_at&.strftime("%H:%M") %></td>
        <td><%= sailing.ln_contact %></td>
        <td><%= sailing.master %></td>
        <td><%= sailing.participants_count %></td>
        <td><%= link_to "Manage Participants", sailing_sailing_participants_path(sailing) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
