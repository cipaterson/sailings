<h1>Voyages</h1>

<%= link_to "New Voyage", new_sailing_path  if can?("office_staff") %>

<table>
  <thead>
    <tr>
      <th>Purpose</th>
      <th>Departs Date</th>
      <th>Departs Time</th>
      <th>Returns Date</th>
      <th>Returns Time</th>
      <th>LN Contact</th>
      <th>Master</th>
      <th>Crew</th>
      <% if can?("crewing_operator") %>
      <th></th>
      <% end %>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @sailings.each do |sailing| %>
      <tr>
          <% if can?("office_staff") %>
          <td><%= link_to sailing.purpose, sailing_path(sailing) %></td>
          <% else %>
          <td><%= sailing.purpose %></td>
          <% end %>
        <td><%= sailing.departs_at&.to_date %></td>
        <td><%= sailing.departs_at&.strftime("%H:%M") %></td>
        <td><%= sailing.returns_at&.to_date unless sailing.returns_at&.to_date == sailing.departs_at&.to_date %></td>
        <td><%= sailing.returns_at&.strftime("%H:%M") %></td>
        <td><%= sailing.ln_contact %></td>
        <td><%= sailing.master %></td>
        <td><%= sailing.participants_count %></td>
        <% if can?("crewing_operator") %>
            <td><%= link_to "Manage Crew", sailing_sailing_participants_path(sailing) %></td>
        <% end %>
        <td>
          <% my_participant = @my_participants[sailing.id] %>
          <% if my_participant %>
            <%= "Registered!" %>
          <% else %>
            <%= button_to "Register", sailing_sailing_participants_path(sailing),
                params: { sailing_participant: { status: "EOI" } } %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
